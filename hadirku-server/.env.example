# ====================================================
# HADIRKU SERVER - KONFIGURASI ENVIRONMENT
# Salin file ini menjadi .env dan isi nilai-nilainya
# ====================================================

# Server
PORT=3001
NODE_ENV=development

# Database MySQL (Laragon)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hadirku_db

# JWT Secret - Ganti dengan string acak yang panjang
JWT_SECRET=hadirku_jwt_secret_ganti_dengan_string_acak_64_karakter_minimal
JWT_EXPIRES_IN=7d

# Session Secret
SESSION_SECRET=hadirku_session_secret_ganti_ini

# URL Frontend
CLIENT_URL=http://localhost:5173

# ====================================================
# GOOGLE OAUTH
# Daftar di: https://console.cloud.google.com
# 1. Buat project baru
# 2. APIs & Services > Credentials > Create OAuth 2.0 Client
# 3. Authorized redirect URIs: http://localhost:3001/auth/google/callback
# ====================================================
GOOGLE_CLIENT_ID=XXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================================================
# FACEBOOK OAUTH
# Daftar di: https://developers.facebook.com
# 1. Buat App baru (Consumer type)
# 2. Facebook Login > Settings
# 3. Valid OAuth Redirect URIs: http://localhost:3001/auth/facebook/callback
# ====================================================
FACEBOOK_APP_ID=000000000000000
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
